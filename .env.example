# Copia este archivo a .env y completa los valores. .env NO se versiona.
# Genera una contraseña fuerte con: openssl rand -base64 24
POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=
TZ=America/Santiago

# Keycloak (el servidor corre fuera de este compose): emisor de los JWT que valida el back
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/siga-realm
# Origen(es) del frontend permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173
