# Copia este archivo a .env y completa los valores. .env NO se versiona.
# Genera una contraseña fuerte con: openssl rand -base64 24
POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=
TZ=America/Santiago

DOCKERHUB_USER=gorack1
BACK_TAG=latest

# Keycloak (corre en este compose). Esta es la URL pública: la del navegador y el iss de los JWT
KEYCLOAK_PUBLIC_URL=http://localhost:9090
KEYCLOAK_REALM=siga-realm
KEYCLOAK_BOOTSTRAP_ADMIN=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
# Origen del frontend (redirect URIs y web origins del cliente siga-frontend)
KEYCLOAK_FRONT_URL=http://localhost:5173
# Primer usuario ADMIN de la app (nadie puede crearlo desde la UI)
SIGA_ADMIN_PASSWORD=
# Origen(es) del frontend permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cuenta de servicio con la que el back crea los usuarios de estudiantes/docentes en Keycloak
KEYCLOAK_ADMIN_CLIENT_ID=siga-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Puerto del back al correrlo con ./mvnw spring-boot:run (el 8080 puede estar ocupado). Los contenedores siguen en 8080
SERVER_PORT=8081
